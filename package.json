{
  "name": "umbra-js",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A small laboratory for learning how light becomes pixels.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "verify": "bash scripts/umbra-verify.sh",
    "verify:smoke": "bash scripts/umbra-verify.sh --with-dev-smoke"
  },
  "devDependencies": {
    "happy-dom": "^20.11.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
